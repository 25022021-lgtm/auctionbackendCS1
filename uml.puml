' Entity Relationships
User "1" -- "1" RefreshToken
User "1" -- "*" Item : sells >
User "1" -- "*" Bid : places >
Item "1" -- "1" ItemStatus : has >
Item "1" -- "*" Bid : receives >

' Layer Dependencies
AuctionController --> AuctionService

AuthController --> AuthService
AuthService --> RefreshTokenRepository
AuthService --> RefreshToken
AuthService --> UserService
AuthService --> JwtUtil

BidController --> BidService
BidService --> BidRepository
BidService --> Bid

ItemController --> ItemService
ItemService --> ItemRepository
ItemService --> Item
ItemService --> ItemStatusService

ItemStatusController --> ItemStatusService
ItemStatusService --> ItemStatusRepository
ItemStatusService --> ItemStatus

UserController --> UserService
UserService --> UserRepository
UserService --> User

' Infrastructure Dependencies
CustomUserDetailsService --> UserRepository
JwtSecurityFilter --> JwtUtil
JwtSecurityFilter --> CustomUserDetailsService

@enduml